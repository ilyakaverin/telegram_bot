{
  "name": "my-chat-bot",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "format": "npx @biomejs/biome format --write ./src",
    "build": "bun build --compile --target=bun-linux-x64-modern src/index.ts --outfile myapp",
    "start": "bun run src/index.ts"
  },
  "nano-staged": {
    "*.{js,ts}": "prettier --write"
  },
  "dependencies": {
    "gramio": "^0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.2.12",
    "bun-types": "latest",
    "nano-staged": "^0.8.0"
  },
  "module": "src/index.ts"
}
